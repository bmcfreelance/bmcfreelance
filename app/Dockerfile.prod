# ── Stage 1: Build ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci                        # Clean install (respects package-lock.json)

COPY . .
RUN npm run build                 # Produces /app/build (Node adapter output)

# Prune dev dependencies
RUN npm ci --omit=dev


# ── Stage 2: Runtime ───────────────────────────────────────────────────────────
# Lean final image — only the build output + prod deps
FROM node:22-alpine AS runner

# Security: don't run as root
RUN addgroup -S sveltekit && adduser -S sveltekit -G sveltekit

WORKDIR /app

# Copy only what's needed to run
COPY --from=builder /app/build    ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

USER sveltekit

EXPOSE 3000

ENV PORT=3000
ENV HOST=0.0.0.0

CMD ["node", "build"]
